# ============================================================
# 校园互助平台 环境变量模板
# 复制为 .env 或直接设置到系统环境变量后启动服务（Key 不要提交进 git）
# Windows PowerShell:   $env:AIC_GLM_API_KEY="你的Key"
# Windows CMD:          set AIC_GLM_API_KEY=你的Key
# 永久（当前用户）:      setx AIC_GLM_API_KEY "你的Key"
# ============================================================

# ---- 智谱 GLM 大模型（AI 解析 / RAG 问答 / 工具调用）----
# 未设置时平台自动降级为规则引擎 + 纯检索兜底，全部功能仍可用（R16 降级设计）
AIC_GLM_API_KEY=
AIC_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
AIC_GLM_MODEL=glm-4-flash
AIC_GLM_TIMEOUT=10

# ---- ASR 语音识别（预留，当前 Demo 为模拟识别）----
AIC_ASR_API_KEY=
AIC_ASR_BASE_URL=

# ---- 服务 ----
# 数据库默认 SQLite（项目内 data/app.db，无外部依赖）
AIC_DB_URL=
# 服务端口（启动命令示例：python -m uvicorn backend.main:app --port 8000）
